---
import ThemeEditor from '../../components/admin/ThemeEditor';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAuthenticatedAdmin } from '../../lib/auth/guard';
import { getD1HomepageSections, getD1StoreConfig } from '../../lib/data/d1-store';
import { DEFAULT_STORE_CONFIG } from '../../lib/data/sample-catalog';
import { SAMPLE_HOMEPAGE_SECTIONS } from '../../lib/data/sample-sections';
import { getWorkerEnv } from '../../lib/env';

const admin = await getAuthenticatedAdmin(Astro.cookies);
if (!admin) return Astro.redirect('/admin/login');

const env = await getWorkerEnv();
const config = (env.DB ? await getD1StoreConfig(env.DB) : null) ?? DEFAULT_STORE_CONFIG;
const sections = env.DB ? await getD1HomepageSections(env.DB) : SAMPLE_HOMEPAGE_SECTIONS;
---

<AdminLayout title="الهوية والتصميم" activeTab="theme" mustChangePassword={admin.must_change_password === 1}>
	<div class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h1 class="text-xl font-extrabold">تخصيص الهوية والصفحة الرئيسية</h1>
			<a
				href="/design-system"
				target="_blank"
				rel="noopener noreferrer"
				class="px-3 py-1.5 rounded-xl border border-slate-700 text-xs font-bold text-slate-200 hover:border-sky-500"
			>
				معاينة نظام التصميم والباليتات ↗
			</a>
		</div>
		<ThemeEditor client:load initialConfig={config} initialSections={sections} />
	</div>
</AdminLayout>
