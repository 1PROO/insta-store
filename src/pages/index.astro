---
import BrandStorySplit from '../components/store/BrandStorySplit.astro';
import CollectionGrid from '../components/store/CollectionGrid.astro';
import HeroVideo from '../components/store/HeroVideo.astro';
import LookbookGrid from '../components/store/LookbookGrid.astro';
import LookbookSlideshow from '../components/store/LookbookSlideshow';
import ProductShelf from '../components/store/ProductShelf.astro';
import PromoGrid from '../components/store/PromoGrid.astro';
import ValuePillars from '../components/store/ValuePillars.astro';
import StoreLayout from '../layouts/StoreLayout.astro';
import { createStoreRepository, resolveActiveUiLang } from '../lib/data/store-repository';
import { getUiDict } from '../lib/i18n/ui';

const repo = createStoreRepository();
const config = await repo.getStoreConfig(Astro.url);
const lang = resolveActiveUiLang(config, Astro.url, Astro.cookies.get('ui_lang')?.value);
const dict = getUiDict(lang);

const [collections, featuredProducts, allProducts, sections] = await Promise.all([
	repo.getVisibleCollections(),
	repo.getFeaturedProducts(),
	repo.getPublishedProducts(),
	repo.getHomepageSections(),
]);
---

<StoreLayout config={config} lang={lang}>
	<HeroVideo config={config} lang={lang} hotspots={sections.heroHotspots} />

	<CollectionGrid collections={collections} lang={lang} />

	<ProductShelf
		title={lang === 'en' ? 'Everyday Essentials' : 'الأساسيات اليومية'}
		products={featuredProducts}
		currency={config.currency}
		lang={lang}
		layout="grid"
	/>

	<PromoGrid cards={sections.promoCards} />

	<ProductShelf
		title={dict.featuredTitle}
		products={allProducts}
		currency={config.currency}
		lang={lang}
		layout="carousel"
	/>

	<BrandStorySplit story={sections.brandStory} />

	<LookbookSlideshow client:visible slides={sections.lookbookSlides} />

	<LookbookGrid tiles={sections.lookbookTiles} lang={lang} />

	<ValuePillars pillars={sections.valuePillars} />
</StoreLayout>
