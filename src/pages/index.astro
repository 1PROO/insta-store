---
import { getAppStatus } from '../lib/health';
import '../styles/global.css';

const status = getAppStatus();
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>insta-store — Setup Ready</title>
	</head>
	<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-6">
		<main class="max-w-md w-full rounded-2xl border border-slate-800 bg-slate-900 p-6 text-center">
			<h1 class="text-xl font-bold mb-2">insta-store</h1>
			<p class="text-sm text-slate-400">
				Phase 2 environment ready ({status.service}: {status.ok ? 'OK' : 'ERR'})
			</p>
		</main>
	</body>
</html>
