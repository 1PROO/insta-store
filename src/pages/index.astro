---
import CollectionGrid from '../components/store/CollectionGrid.astro';
import HeroVideo from '../components/store/HeroVideo.astro';
import ProductCard from '../components/store/ProductCard.astro';
import StoreLayout from '../layouts/StoreLayout.astro';
import { createStoreRepository, resolveActiveUiLang } from '../lib/data/store-repository';
import { getUiDict } from '../lib/i18n/ui';

const repo = createStoreRepository();
const config = await repo.getStoreConfig(Astro.url);
const lang = resolveActiveUiLang(config, Astro.url, Astro.cookies.get('ui_lang')?.value);
const dict = getUiDict(lang);

const [collections, featuredProducts] = await Promise.all([
	repo.getVisibleCollections(),
	repo.getFeaturedProducts(),
]);
---

<StoreLayout config={config} lang={lang}>
	<HeroVideo config={config} lang={lang} />

	<CollectionGrid collections={collections} lang={lang} />

	{
		featuredProducts.length > 0 && (
			<section class="max-w-6xl mx-auto px-4 pt-12 sm:pt-16">
				<div class="flex items-center justify-between mb-5">
					<h2 class="text-lg sm:text-2xl font-bold tracking-tight">{dict.featuredTitle}</h2>
					<a
						href="/shop"
						class="text-xs font-semibold underline underline-offset-4"
						style="color: var(--text-muted);"
					>
						{dict.viewAll}
					</a>
				</div>

				<div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-5">
					{featuredProducts.map((product) => (
						<ProductCard product={product} currency={config.currency} lang={lang} />
					))}
				</div>
			</section>
		)
	}
</StoreLayout>
