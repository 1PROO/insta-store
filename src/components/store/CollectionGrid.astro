---
import type { Collection, UiLang } from '../../lib/domain/types';
import { getUiDict } from '../../lib/i18n/ui';

interface Props {
	collections: Collection[];
	lang: UiLang;
}

const { collections, lang } = Astro.props;
const dict = getUiDict(lang);
---

{
	collections.length > 0 && (
		<section class="max-w-6xl mx-auto px-4 pt-10 sm:pt-14">
			<div class="flex items-center justify-between mb-5">
				<h2 class="text-lg sm:text-2xl font-bold tracking-tight">{dict.collectionsTitle}</h2>
				<a href="/shop" class="text-xs font-semibold underline underline-offset-4" style="color: var(--text-muted);">
					{dict.viewAll}
				</a>
			</div>

			<div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-5">
				{collections.map((col) => (
					<a
						href={`/c/${col.slug}`}
						class="group relative block overflow-hidden store-card aspect-[4/5]"
					>
						<img
							src={col.imageUrl}
							alt={col.name}
							loading="lazy"
							class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent" />
						<span class="absolute bottom-3 start-3 end-3 text-white font-bold text-sm sm:text-base">
							{col.name}
						</span>
					</a>
				))}
			</div>
		</section>
	)
}
