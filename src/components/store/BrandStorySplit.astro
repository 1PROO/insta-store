---
import type { BrandStoryBlock } from '../../lib/domain/types';

interface Props {
	story: BrandStoryBlock | null;
}

const { story } = Astro.props;
---

{
	story && (
		<section class="max-w-6xl mx-auto px-4 pt-14 sm:pt-20">
			<div class="store-surface p-6 sm:p-10 grid md:grid-cols-12 gap-8 items-center">
				<div class="md:col-span-5 space-y-4">
					<p class="text-xs font-bold uppercase tracking-[0.16em]" style="color: var(--text-muted);">
						{story.eyebrow}
					</p>
					<h2 class="text-2xl sm:text-3xl font-extrabold leading-tight">{story.title}</h2>
					<p class="text-sm leading-relaxed" style="color: var(--text-muted);">
						{story.body}
					</p>
					<a href={story.ctaHref} class="inline-block px-5 py-2.5 text-xs font-bold store-btn-primary">
						{story.ctaLabel}
					</a>
				</div>

				<div class="md:col-span-7 grid grid-cols-2 gap-3 sm:gap-4 items-end">
					<div class="overflow-hidden store-card aspect-[3/4]">
						<img
							src={story.primaryImageUrl}
							alt={story.title}
							loading="lazy"
							class="w-full h-full object-cover"
						/>
					</div>
					<div class="overflow-hidden store-card aspect-[3/4] translate-y-3 sm:translate-y-5">
						<img
							src={story.secondaryImageUrl}
							alt={story.title}
							loading="lazy"
							class="w-full h-full object-cover"
						/>
					</div>
				</div>
			</div>
		</section>
	)
}
