---
import type { LookbookTile, UiLang } from '../../lib/domain/types';

interface Props {
	tiles: LookbookTile[];
	lang: UiLang;
}

const { tiles, lang } = Astro.props;
---

{
	tiles.length > 0 && (
		<section class="max-w-6xl mx-auto px-4 pt-12 sm:pt-16">
			<div class="flex items-center justify-between mb-5">
				<h2 class="text-lg sm:text-2xl font-bold tracking-tight">
					{lang === 'en' ? 'The Lookbook' : 'معرض الإطلالات'}
				</h2>
			</div>
			<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
				{tiles.map((tile) => (
					<a href={tile.href} class="group relative block overflow-hidden store-card aspect-square">
						<img
							src={tile.imageUrl}
							alt={tile.label}
							loading="lazy"
							class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent" />
						<span class="absolute bottom-3 start-3 end-3 text-white text-xs sm:text-sm font-bold">
							{tile.label}
						</span>
					</a>
				))}
			</div>
		</section>
	)
}
