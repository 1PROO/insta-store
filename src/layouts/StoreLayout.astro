---
import CartDrawer from '../components/store/CartDrawer';
import type { StoreConfig, UiLang } from '../lib/domain/types';
import { getUiDict } from '../lib/i18n/ui';
import { sanitizeHref } from '../lib/security/urls';
import { renderThemeCssVariables, resolveThemeTokens } from '../lib/theme/presets';
import '../styles/global.css';

interface Props {
	config: StoreConfig;
	lang: UiLang;
	pageTitle?: string;
	pageDescription?: string;
	ogImage?: string;
	ogType?: 'website' | 'product';
}

const { config, lang, pageTitle, pageDescription, ogImage, ogType = 'website' } = Astro.props;
const dict = getUiDict(lang);
const { tokens } = resolveThemeTokens({
	presetId: config.presetId,
	radiusPreset: config.radiusPreset,
	customAccent: config.customAccent,
	customBtnBg: config.customBtnBg,
	customBtnText: config.customBtnText,
});
const themeCss = renderThemeCssVariables(tokens);
const dir = lang === 'en' ? 'ltr' : 'rtl';
const fullTitle = pageTitle ? `${pageTitle} | ${config.storeName}` : config.storeName;
const metaDesc = pageDescription || config.tagline;
const metaImg = ogImage || config.heroPosterUrl;
const canonicalUrl = `${Astro.url.origin}${Astro.url.pathname}`;

const nextLang = lang === 'ar' ? 'en' : 'ar';
const toggleUrl = new URL(Astro.url);
toggleUrl.searchParams.set('lang', nextLang);

const whatsappHref = config.whatsappNumber
	? `https://wa.me/${config.whatsappNumber.replace(/[^0-9]/g, '')}`
	: null;
const safeInstaHref = config.instagramUrl ? sanitizeHref(config.instagramUrl, '') : '';
const safeMetaPixel = config.metaPixelId?.replace(/[^0-9]/g, '') || null;
const safeTiktokPixel = config.tiktokPixelId?.replace(/[^a-zA-Z0-9_-]/g, '') || null;
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={metaDesc} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href={config.logoUrl || '/samples/hero-poster.svg'} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={metaDesc} />
		<meta property="og:image" content={metaImg} />
		<meta property="og:url" content={canonicalUrl} />
		<style is:inline set:html={themeCss}></style>
		{
			safeMetaPixel && (
				<script
					is:inline
					set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${safeMetaPixel}');fbq('track','PageView');`}
				/>
			)
		}
		{
			safeTiktokPixel && (
				<script
					is:inline
					set:html={`!function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"];ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.load=function(e,n){var i="https://analytics.tiktok.com/i18n/pixel/events.js";ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=i;ttq._t=ttq._t||{};ttq._t[e]=+new Date;ttq._o=ttq._o||{};ttq._o[e]=n||{};var o=document.createElement("script");o.type="text/javascript";o.async=!0;o.src=i+"?sdkid="+e+"&lib="+t;var a=document.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};ttq.load('${safeTiktokPixel}');ttq.page()}(window,document,'ttq');`}
				/>
			)
		}
	</head>
	<body class="min-h-screen flex flex-col">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:p-2 focus:bg-black focus:text-white">
			{lang === 'en' ? 'Skip to content' : 'الانتقال للمحتوى'}
		</a>

		{
			config.announcementText && (
				<div
					class="text-xs font-medium text-center px-4 py-2 tracking-wide"
					style="background-color: var(--btn-bg); color: var(--btn-text);"
				>
					{config.announcementText}
				</div>
			)
		}

		<header
			class="sticky top-0 z-40 backdrop-blur-md border-b"
			style="background-color: color-mix(in srgb, var(--bg-primary) 90%, transparent); border-color: var(--border-subtle);"
		>
			<div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between gap-3">
				<div class="flex items-center gap-2">
					<button
						type="button"
						id="mobileMenuBtn"
						aria-label="Menu"
						aria-expanded="false"
						class="md:hidden w-10 h-10 inline-flex items-center justify-center rounded-md"
						style="color: var(--text-primary);"
					>
						<svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
							<path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
						</svg>
					</button>
					<nav class="hidden md:flex items-center gap-5 text-sm font-medium">
						<a href="/" class="hover:opacity-70">{dict.navHome}</a>
						<a href="/shop" class="hover:opacity-70">{dict.navShop}</a>
						<a href="/design-system" class="hover:opacity-70" style="color: var(--text-muted);"
							>{dict.navDesignSystem}</a
						>
					</nav>
				</div>

				<a href="/" class="flex items-center gap-2 text-base sm:text-lg font-extrabold tracking-[0.14em] uppercase truncate">
					{
						config.logoUrl ? (
							<img src={config.logoUrl} alt={config.storeName} class="h-8 w-auto object-contain" />
						) : (
							<span>{config.storeName}</span>
						)
					}
				</a>

				<div class="flex items-center gap-1.5 sm:gap-2">
					<a
						href="/shop"
						aria-label={lang === 'en' ? 'Search catalog' : 'بحث في المنتجات'}
						class="w-9 h-9 inline-flex items-center justify-center border"
						style="border-color: var(--border-subtle); border-radius: var(--radius-btn);"
					>
						<svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
							<circle cx="11" cy="11" r="7" />
							<path stroke-linecap="round" d="m20 20-3.5-3.5" />
						</svg>
					</a>
					{
						config.languageMode === 'both' && (
							<a
								href={toggleUrl.pathname + toggleUrl.search}
								data-set-lang={nextLang}
								class="lang-switch text-xs font-semibold px-2.5 py-1.5 border"
								style="border-color: var(--border-subtle); border-radius: var(--radius-btn);"
							>
								{dict.langToggleLabel}
							</a>
						)
					}
					<button
						type="button"
						id="headerCartBtn"
						class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-2 store-btn-outline"
					>
						<svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M6 7h12l-1 13H7L6 7Zm3 0a3 3 0 0 1 6 0"
							/>
						</svg>
						<span>{dict.cartLabel}</span>
						<span id="headerCartCount" class="text-[11px] opacity-75">(0)</span>
					</button>
				</div>
			</div>

			<div
				id="mobileDrawer"
				class="hidden md:hidden border-t px-4 py-4 space-y-3 text-sm font-medium"
				style="background-color: var(--bg-surface); border-color: var(--border-subtle);"
			>
				<a href="/" class="block py-1">{dict.navHome}</a>
				<a href="/shop" class="block py-1">{dict.navShop}</a>
				<a href="/design-system" class="block py-1" style="color: var(--text-muted);"
					>{dict.navDesignSystem}</a
				>
				<a href="/admin" class="block py-1" style="color: var(--text-muted);">{dict.navAdmin}</a>
			</div>
		</header>

		<main id="main-content" class="flex-1">
			<slot />
		</main>

		<footer class="border-t mt-14" style="border-color: var(--border-subtle); background-color: var(--bg-surface);">
			<div class="max-w-6xl mx-auto px-4 py-10 grid gap-6 sm:grid-cols-2 items-center">
				<div>
					<p class="font-extrabold tracking-[0.12em] uppercase text-sm mb-1">{config.storeName}</p>
					<p class="text-xs leading-relaxed" style="color: var(--text-muted);">{config.tagline}</p>
				</div>
				<div class="flex flex-wrap gap-3 sm:justify-end">
					{
						whatsappHref && (
							<a
								href={whatsappHref}
								target="_blank"
								rel="noopener noreferrer"
								class="px-4 py-2 text-xs font-semibold store-btn-primary"
							>
								{dict.whatsappLabel}
							</a>
						)
					}
					{
						safeInstaHref && (
							<a
								href={safeInstaHref}
								target="_blank"
								rel="noopener noreferrer"
								class="px-4 py-2 text-xs font-semibold store-btn-outline"
							>
								{dict.instagramLabel}
							</a>
						)
					}
					<a href="/design-system" class="px-4 py-2 text-xs font-semibold store-btn-outline">
						{dict.navDesignSystem}
					</a>
				</div>
			</div>
		</footer>

		<CartDrawer
			client:load
			currency={config.currency}
			lang={lang}
			emptyText={dict.emptyCart}
			continueText={dict.continueShopping}
			checkoutText={dict.goToCheckout}
			cartLabel={dict.cartLabel}
		/>

		<script is:inline>
			const menuBtn = document.getElementById('mobileMenuBtn');
			const drawer = document.getElementById('mobileDrawer');
			if (menuBtn && drawer) {
				menuBtn.addEventListener('click', () => {
					const hidden = drawer.classList.toggle('hidden');
					menuBtn.setAttribute('aria-expanded', hidden ? 'false' : 'true');
				});
			}
			const cartBtn = document.getElementById('headerCartBtn');
			if (cartBtn) {
				cartBtn.addEventListener('click', () => {
					window.dispatchEvent(new CustomEvent('insta-store:open-cart'));
				});
			}
			document.querySelectorAll('.lang-switch').forEach((el) => {
				el.addEventListener('click', () => {
					const val = el.getAttribute('data-set-lang');
					if (val) document.cookie = `ui_lang=${val}; Path=/; Max-Age=2592000; SameSite=Lax`;
				});
			});
		</script>
	</body>
</html>
